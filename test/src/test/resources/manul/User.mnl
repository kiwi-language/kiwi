class User (
    @Summary
    var loginName: string,
    priv var password: string
) {

    var credits = 0

    fn verify(password: string) -> bool {
        return password == this.password
    }

}

@Searchable
class Application(
    var name: string,
    var owner: User
) {

    val members = new User[]

    {
        members.append(owner)
    }

}